@startuml

actor Client

participant "Portfolio Service\n(JWT Filter)" as Filter
participant "Controller" as Controller
participant "Service Layer" as Service
participant "Redis Cache" as Cache
participant "Repository" as Repo
database "MongoDB" as DB

== Update Flow ==

Client -> Filter : HTTP Request (JWT + Update Data)

Filter -> Filter : Validate JWT
Filter -> Filter : Extract userId

Filter -> Controller : Forward request

Controller -> Service : updateProfile(userId, data)

Service -> Repo : save(profile)
Repo -> DB : Update Document
DB --> Repo : Saved Entity
Repo --> Service : Profile

== Cache Eviction ==

Service -> Cache : DELETE profile:userId

Service --> Controller : Return DTO
Controller --> Client : Response (200 OK)

@enduml